# Copy to .env and fill in from your Supabase project (Settings -> API).
# These are safe to expose in the frontend; the LLM API key is NOT here —
# it lives only in Supabase function secrets (supabase secrets set GEMINI_API_KEY=...).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public Edge Function URL. This is not a secret.
VITE_ANALYTICS_ENDPOINT=https://qbqvedvzakahpaqrdfkh.supabase.co/functions/v1/portfolio-analytics
